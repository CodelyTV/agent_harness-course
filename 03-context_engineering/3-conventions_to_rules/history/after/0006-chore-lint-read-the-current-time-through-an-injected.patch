diff --git a/etc/eslint/rules/no-system-time.mjs b/etc/eslint/rules/no-system-time.mjs
new file mode 100644
index 0000000..01fd008
--- /dev/null
+++ b/etc/eslint/rules/no-system-time.mjs
@@ -0,0 +1,29 @@
+const message =
+	"Do not read the system time here: inject a Clock and call clock.now(). SystemClock is the only adapter that reads it. Convention: src/contexts/backend/reviews/application/create/ProductReviewCreator.ts";
+
+export const noSystemTime = {
+	meta: {
+		type: "problem",
+		docs: {
+			description: "Read the current time through an injected Clock",
+		},
+		schema: [],
+		messages: {
+			systemTime: message,
+		},
+	},
+	create(context) {
+		return {
+			"NewExpression[callee.type='Identifier'][callee.name='Date'][arguments.length=0]"(
+				node,
+			) {
+				context.report({ node, messageId: "systemTime" });
+			},
+			"CallExpression[callee.type='MemberExpression'][callee.object.name='Date'][callee.property.name='now']"(
+				node,
+			) {
+				context.report({ node, messageId: "systemTime" });
+			},
+		};
+	},
+};
diff --git a/tests/eslint/noSystemTime.spec.ts b/tests/eslint/noSystemTime.spec.ts
new file mode 100644
index 0000000..0053b4e
--- /dev/null
+++ b/tests/eslint/noSystemTime.spec.ts
@@ -0,0 +1,61 @@
+import { describe, expect, it } from "vitest";
+
+import { lintAs } from "./lintAs";
+
+const rule = "retail/no-system-time";
+const filePath =
+	"src/contexts/backend/rule-test-system-time/application/WishlistAdder.ts";
+
+describe(rule, () => {
+	it("fails when a use case creates a Date for now", async () => {
+		const messages = await lintAs(
+			filePath,
+			[
+				"export function addedAt(): string {",
+				"\treturn new Date().toISOString();",
+				"}",
+				"",
+			].join("\n"),
+		);
+
+		expect(messages.map((message) => message.ruleId)).toContain(rule);
+	}, 30_000);
+
+	it("fails when a use case calls Date.now", async () => {
+		const messages = await lintAs(
+			filePath,
+			[
+				"export function addedAt(): number {",
+				"\treturn Date.now();",
+				"}",
+				"",
+			].join("\n"),
+		);
+
+		expect(messages.map((message) => message.ruleId)).toContain(rule);
+	}, 30_000);
+
+	it("passes when a use case asks an injected Clock and parses dates", async () => {
+		const messages = await lintAs(
+			filePath,
+			[
+				'import type { Clock } from "@/contexts/shared/domain/Clock";',
+				"",
+				"export class WishlistAdder {",
+				"\tconstructor(private readonly clock: Clock) {}",
+				"",
+				"\taddedAt(): string {",
+				"\t\treturn this.clock.now();",
+				"\t}",
+				"",
+				"\tyearOf(date: string): number {",
+				"\t\treturn new Date(date).getFullYear();",
+				"\t}",
+				"}",
+				"",
+			].join("\n"),
+		);
+
+		expect(messages).toEqual([]);
+	}, 30_000);
+});
