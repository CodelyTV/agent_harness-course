From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Irene Sanz <irene.sanz@example.com>
Date: Mon, 16 Nov 2026 10:21:00 +0100
Subject: [PATCH 4/6] chore(lint): forbid new route handlers in the app

The products, orders and cart migrations (ed28e1b, 629e42a, 5c3032b) replaced the /api endpoints with server components and server actions. The wishlist and newsletter route handlers are the baseline in eslint-suppressions.json.

Co-Authored-By: Claude Code - Claude Opus 5.5 <noreply@anthropic.com>
---
 eslint-suppressions.json           |  6 +++++
 eslint.config.mjs                  | 13 +++++++++
 tests/eslint/routeHandlers.spec.ts | 42 ++++++++++++++++++++++++++++++
 3 files changed, 61 insertions(+)
 create mode 100644 tests/eslint/routeHandlers.spec.ts

diff --git a/eslint-suppressions.json b/eslint-suppressions.json
index c8ca6f5..0feaad3 100644
--- a/eslint-suppressions.json
+++ b/eslint-suppressions.json
@@ -2,11 +2,17 @@
   "src/app/api/newsletter/route.ts": {
     "import/no-restricted-paths": {
       "count": 1
+    },
+    "no-restricted-syntax": {
+      "count": 1
     }
   },
   "src/app/api/wishlist/route.ts": {
     "import/no-restricted-paths": {
       "count": 1
+    },
+    "no-restricted-syntax": {
+      "count": 1
     }
   },
   "src/services/NewsletterService.ts": {
diff --git a/eslint.config.mjs b/eslint.config.mjs
index 137f1f9..2f5b168 100644
--- a/eslint.config.mjs
+++ b/eslint.config.mjs
@@ -76,4 +76,17 @@ export default [
 			],
 		},
 	},
+	{
+		files: ["src/app/**/route.{js,ts,tsx}"],
+		rules: {
+			"no-restricted-syntax": [
+				"error",
+				{
+					selector: "Program",
+					message:
+						"Do not add route handlers. Read data in a server component through RetailContainer and change it with a server action in src/app/actions. Convention: src/app/actions/checkout/addSelectedVariantToCart.ts",
+				},
+			],
+		},
+	},
 ];
diff --git a/tests/eslint/routeHandlers.spec.ts b/tests/eslint/routeHandlers.spec.ts
new file mode 100644
index 0000000..583c04c
--- /dev/null
+++ b/tests/eslint/routeHandlers.spec.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+
+import { lintAs } from "./lintAs";
+
+const rule = "no-restricted-syntax";
+
+describe(`${rule} on route handlers`, () => {
+	it("fails on a new route handler", async () => {
+		const messages = await lintAs(
+			"src/app/api/rule-test-route-handlers/route.ts",
+			[
+				"export function GET(): Response {",
+				"\treturn Response.json({ ok: true });",
+				"}",
+				"",
+			].join("\n"),
+		);
+
+		expect(messages.map((message) => message.ruleId)).toContain(rule);
+	}, 30_000);
+
+	it("passes on a server action", async () => {
+		const messages = await lintAs(
+			"src/app/actions/rule-test-route-handlers/removeFromCart.ts",
+			[
+				'"use server";',
+				"",
+				'import { revalidatePath } from "next/cache";',
+				"",
+				'import { retailContainer } from "@/contexts/backend/shared/infrastructure/RetailContainer";',
+				"",
+				"export async function removeFromCart(variantId: string): Promise<void> {",
+				"\tawait retailContainer.cartVariantRemover.remove(variantId);",
+				'\trevalidatePath("/checkout");',
+				"}",
+				"",
+			].join("\n"),
+		);
+
+		expect(messages).toEqual([]);
+	}, 30_000);
+});
-- 
