 tests/eslint/lintAs.ts | 49 ++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 52 insertions(+)
 create mode 100644 tests/eslint/lintAs.ts

diff --git a/eslint.config.mjs b/eslint.config.mjs
index 2037c14..aa6128e 100644
--- a/eslint.config.mjs
+++ b/eslint.config.mjs
@@ -2,6 +2,9 @@ import eslintConfigNext from "@next/eslint-plugin-next";
 import eslintConfigCodely from "eslint-config-codely";
 import globals from "globals";
 
+// Baseline: eslint-suppressions.json lists the code that broke a rule the day the rule arrived.
